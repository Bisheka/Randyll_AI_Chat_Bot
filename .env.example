# Copy to .env ??? never commit a real .env. No key is ever exposed to the frontend.
# Chat LLM priority: Gemini > Anthropic > OpenAI > offline extractive answers.
# Embeddings: OpenAI if keyed, else local hash (dev).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Leave QDRANT_URL empty for the local dev vector store; Docker Compose sets it.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=randyll_university_knowledge
ADMIN_API_KEY=dev-admin-key-change-me
KNOWLEDGE_DIR=D:\Randyll\Randyll_Data
KNOWLEDGE_HOST_DIR=D:\Randyll\Randyll_Data
SQLSERVER_DSN=
CHAT_RATE_LIMIT_PER_MIN=30
SESSION_RETENTION_DAYS=30
MAX_UPLOAD_MB=25
NEXT_PUBLIC_API_URL=http://localhost:8000
